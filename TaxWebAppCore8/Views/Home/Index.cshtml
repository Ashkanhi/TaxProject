@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "ارسال فاکتور";
    bool isOmidService = string.Equals(
        TaxServiceAndApp.BI.BMain.SrvInfo?.ServiceType?.Trim(),
        "Omid",
        System.StringComparison.OrdinalIgnoreCase);
}
<style>

 
    #butensDiv .btn {
        border-radius: 8px;
        font-size: 14px;
        font-weight: bold;
        padding: 8px 12px;
        margin: 4px;
        color: #ffffff;
        transition: 0.2s;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        display: inline-flex;
        align-items: center;
    }

        #butensDiv .btn i {
            margin-left: 5px;
            font-size: 16px;
            color: #ffffff;
        }

    .custom-search {
        background-color: #3498db; /* آبی */
    }

        .custom-search:hover {
            background-color: #2980b9;
        }

    .custom-select-all {
        background-color: #7f8c8d; /* خاکستری خنثی */
    }

        .custom-select-all:hover {
            background-color: #606b6b;
        }

    .custom-send-group {
        background-color: #27ae60; /* سبز ارسال */
    }

        .custom-send-group:hover {
            background-color: #1e8449;
        }

    .custom-excel {
        background-color: #16a085; /* سبزآبی برای اکسل */
    }

        .custom-excel:hover {
            background-color: #128770;
        }

    .custom-check-connection {
        background-color: #e67e22; /* نارنجی برای تست */
    }


    .content-header {
        margin-bottom: 24px;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        margin: 0;
        padding-bottom: 4px;
        color: #2c3e50;
        border-bottom: 1px solid #ddd;
    }

    .page-subtitle {
        font-size: 16px;
        color: #7f8c8d;
        font-weight: normal;
    }

    /* اگر کل صفحه راست‌ چین است */
    .text-right {
        text-align: right;
    }



    /* ردیف انتخاب‌شده توسط کاربر */
    table.dataTable tr.selected tr.row_selected {
        background-color: #cce5ff !important;
        color: #004085 !important;
        font-weight: bold;
    }

    /* آیکون '+' با رنگ ملایم */
    td.details-control i {
        color: #555;
        font-size: 16px;
    }

    td.details-control:hover i {
        color: #007bff;
        cursor: pointer;
    }






        .custom-check-connection:hover {
            background-color: #cf711f;
        }
    .custom-blue-notification {
        background-color: #3498db !important;
        border-color: #2980b9 !important;
        left: 20px !important; /* Adjust the distance from the left edge */
        top: 150px !important; /* Adjust the vertical positioning */
        right: auto !important;
    }

        .custom-blue-notification h4,
        .custom-blue-notification div {
            color: #ffffff !important;
        }


    /* فونت کلی جدول */
    table.dataTable {
        font-family: "IRANSans", "Vazir", "Tahoma", sans-serif;
        font-size: 15px;
        font-weight: 500;
        border: 1px solid #aaa;
        background-color: #fefefe;
    }

        /* عنوان ستون‌ها */
        table.dataTable thead th {
            font-size: 16px;
            font-weight: 700;
            background-color: #dcdcdc;
            color: #1a1a1a;
            text-align: center;
            border-bottom: 2px solid #999;
            padding: 12px 8px;
        }

        /* سطرهای بدنه */
        table.dataTable tbody td {
            font-size: 15px;
            font-weight: 600;
            color: #222;
            text-align: center;
            padding: 10px;
            line-height: 1.8;
            border-bottom: 1px solid #ccc;
            vertical-align: middle;
        }

        /* سطرها در حالت عادی و hover */
        table.dataTable tbody tr {
            background-color: #fff;
            transition: background-color 0.3s ease;
        }

            table.dataTable tbody tr:hover {
                background-color: #f2f2f2;
            }

        /* سطر انتخاب‌شده */
        table.dataTable tr.selected {
            background-color: #cbe2ff !important;
            color: #0d2a4d !important;
            font-weight: 700;
        }

    /* وضعیت‌ها با رنگ ویژه */
    .row-error {
        background-color: #fa5555 !important;
        color: #9f0000 !important;
        font-weight: 700;
    }

    .row-success {
        background-color: #70ff85 !important;
        color: #12733f !important;
        font-weight: 700;
    }

    .row-warning {
        background-color: #fcbc0a !important;
        color: #fcbc0a !important;
        font-weight: 700;
    }

    /* آیکون‌های expandable */
    td.details-control i {
        color: #333;
        font-size: 17px;
    }

    td.details-control:hover i {
        color: #007bff;
        cursor: pointer;
    }



    .x_panel, .myContainer {
        background-color: darkgrey; /* پنل کمی روشن‌تر از قبل */
        border: 1px solid #3e4f5c;
        border-radius: 10px;
        box-shadow: 0 5px 15px;
        padding: 20px;
        margin-bottom: 24px;
    }


    .custom-blue-notification {
        background-color: #3498db !important;
        border-color: #2980b9 !important;
        left: 20px !important; /* Adjust the distance from the left edge */
        top: 200px !important; /* Adjust the vertical positioning */
        right: auto !important;
    }

        .custom-blue-notification h4,
        .custom-blue-notification div {
            color: #ffffff !important;
        }

    .custom-select {
        color: black; /* رنگ متن غیر انتخاب شده */
        font-weight: bold; /* پر رنگ کردن متن */
    }

        /* رنگ متن گزینه‌ها */
        .custom-select option {
            color: black; /* رنگ متن گزینه‌ها */
            font-weight: bold; /* پر رنگ کردن متن گزینه‌ها */
        }

        /* برای تغییر رنگ متن گزینه‌های انتخاب شده */
        .custom-select:focus {
            color: green; /* رنگ متن باکس در حالت فوکوس */
        }

        /* اگر بخواهید رنگ متن انتخاب شده را به مشکی تغییر دهید */
        .custom-select option:checked {
            color: green; /* رنگ متن گزینه‌های انتخاب شده */
        }

    .select2-container .select2-selection--multiple .select2-selection__choice {
        background-color: green; /* رنگ پس‌زمینه انتخاب شده */
        color: white; /* رنگ متن انتخاب شده */
        font-weight: bold; /* پررنگ کردن متن انتخاب شده */
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        background-color: green; /* رنگ پس‌زمینه انتخاب شده */
        color: white; /* رنگ متن انتخاب شده */
        font-weight: bold; /* پررنگ کردن متن انتخاب شده */
    }
</style>
@if (isOmidService)
{
    <link rel="stylesheet" href="~/Content/OmidTheme.css" asp-append-version="true" />
}
@if (!isOmidService)
{
    <section class="content-header text-right omid-page-heading">
        <h1 class="page-title">
            ارسال فاکتور
            <br />
        </h1>
    </section>
}
<div id="omidSendPage" class="col-md-12 col-sm-12 col-xs-12" style="direction:rtl;">


    <div class="" style="direction:rtl;width:100% !important;">
        <div class="x_panel" style="width:100%">
            @if (isOmidService)
            {
                <div class="omid-card-heading">
                    <span class="omid-card-heading-icon" aria-hidden="true">
                        <i class="fa fa-paper-plane-o"></i>
                    </span>
                    <h1>پنل ارسال صورتحساب</h1>
                </div>
            }
            <div class="card-body">
                <form id="frmSearch">
                    <div class="row form-group" style="margin:0;">

                        <div class="col-md-3 col-sm-4 col-xs-12 form-group">
                            <label class="control-label col-md-3 col-sm-12 col-xs-12 col-lg-3 col-xl-3" for="txtFromDate">
                                از تاریخ
                            </label>
                            <div class="col-md-9 col-sm-12 col-xs-12 col-lg-9 col-xl-9">
                                <div class="input-group">
                                    <div class="input-group-addon" data-mddatetimepicker="true" data-trigger="click" data-targetselector="#txtFromDate" data-groupid="group1"
                                         data-fromdate="true" data-enabletimepicker="false" data-placement="left">
                                        <span class="glyphicon glyphicon-calendar"></span>
                                    </div>
                                    <input type="text" class="form-control" id="txtFromDate" placeholder="تاریخ اعتبار تا" data-mddatetimepicker="true" data-trigger="click"
                                           data-targetselector="#txtFromDate" data-groupid="group1" data-fromdate="true" data-enabletimepicker="false" data-placement="bottom" />
                                </div>

                            </div>
                        </div>
                        <div class="col-md-3 col-sm-4 col-xs-12 form-group">
                            <label class="control-label col-md-3 col-sm-12 col-xs-12 col-lg-3 col-xl-3" for="txtToDate">
                                تا تاریخ
                            </label>
                            <div class="col-md-9 col-sm-12 col-xs-12 col-lg-9 col-xl-9">
                                <div class="input-group">
                                    <div class="input-group-addon" data-mddatetimepicker="true" data-trigger="click" data-targetselector="#txtToDate" data-groupid="group1"
                                         data-fromdate="true" data-enabletimepicker="false" data-placement="left">
                                        <span class="glyphicon glyphicon-calendar"></span>
                                    </div>
                                    <input type="text" class="form-control" id="txtToDate" placeholder="تاریخ اعتبار تا" data-mddatetimepicker="true" data-trigger="click"
                                           data-targetselector="#txtToDate" data-groupid="group1" data-fromdate="true" data-enabletimepicker="false" data-placement="bottom" />
                                </div>

                            </div>
                        </div>
                        <div class="col-md-3 col-sm-4 col-xs-12 form-group">
                            <label class="control-label col-md-3 col-sm-12 col-xs-12 col-lg-3 col-xl-3" for="cmdStat">
                                وضعیت
                            </label>
                            <div class="col-md-9 col-sm-12 col-xs-12 col-lg-9 col-xl-9">
                                <select id="cmdStat" class="form-control select">
                                    <option value="1" selected>ارسال نشده</option>
                                    <option value="2">ارسال شده(وضعیت نامشخص)</option>
                                    <option value="3">ارسال شده با خطا</option>
                                    <option value="4">ارسال موفق</option>
                                    <option value="-1">همه</option>
                                </select>
                                <select id="cmbErrorTypes" class="form-control select">
                                    <option>همه</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-4 col-xs-12 form-group">
                            <label class="control-label col-md-3 col-sm-12 col-xs-12 col-lg-3 col-xl-3" for="cmbStores">
                                فروشگاه
                            </label>
                            <div class="col-md-9 col-sm-12 col-xs-12 col-lg-9 col-xl-9">
                                <select id="cmbStores" multiple class="form-control custom-select">
                                    <option value="0">همه</option>
                                </select>

                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class=" row">
                <div class="form-group" id="butensDiv" style="float:right;">
                    <button type="button" id="btnSearch" class="btn custom-search">
                        <i class="fa fa-search"></i> جستجو
                    </button>

                    <button type="button" id="btnSelectAll" class="btn custom-select-all">
                        <i class="fa fa-check-square-o"></i> انتخاب همه
                    </button>

                    @if (string.Equals(
                    TaxServiceAndApp.BI.BMain.SrvInfo?.ServiceType?.Trim(),
                    "Omid",
                    System.StringComparison.OrdinalIgnoreCase))
                    {
                        <button type="button" id="btnSendOmidInvoices" class="btn custom-send-group">
                            <i class="fa fa-paper-plane"></i> ارسال صورتحساب
                        </button>
                    }
                    else
                    {
                        <button type="button" id="btnSendGroupForTax" class="btn custom-send-group">
                            <i class="fa fa-paper-plane"></i> ارسال گروهی
                        </button>
                    }


                    <button type="button" id="btnExportExcel" class="btn custom-excel">
                        <i class="fa fa-file-excel-o"></i> خروجی اکسل
                    </button>

                    <button type="button" id="btnExportExcelSummary" class="btn custom-excel">
                        <i class="fa fa-file-excel-o"></i> خروجی اکسل خلاصه
                    </button>

                    <button type="button" id="btnExportExcelInq" class="btn custom-excel">
                        <i class="fa fa-file-excel-o"></i> خروجی اکسل با استعلام
                    </button>

                    <button type="button" id="btnCheckConnection" class="btn custom-check-connection">
                        <i class="fa fa-check-square"></i> تست ارتباط
                    </button>
                </div>

                <div class="row" id="waiting" style="text-align:center;display:none"><span style="color:red;">عملیات ممکن است طول بکشد لطفا صبر کنید</span></div>
            </div>
        </div>

        <div class="x_panel">
            <div class="panel-body" id="MDL_REPPersonlyF_mdlGroupingActionOnCards_TblPersonsDiv"
                 style="">
                <div class="col-md-12" style="">
                    <div class="x_content">
                        <p style="text-align:center;color:black"> لیست فاکتورهای</p>
                        <div class="table-responsive">
                            <table id="tblDoNotSend" class="table table-striped table-bordered table-sm jambo_table  dt-responsive " style="width: 100%">

                                <thead>
                                    <tr>
                                        <th>sendStat</th>
                                        <th>sendStat</th>
                                        <th>Index</th>
                                        <th>Index</th>
                                        <th>invoiceId</th>
                                        <th>RealInvoiceNumber</th>
                                        <th>persianCreateDate</th>
                                        <th>persianCreateDate</th>
                                        <th>customerName</th>
                                        <th>customerName</th>
                                        <th>customerName</th>
                                        <th>customerName</th>
                                        <th>invoiceDescription</th>
                                        <th>totalPrice</th>
                                        <th>totalDiscount</th>
                                        <th>netPrice</th>
                                        <th>totalTax</th>
                                        @if (!string.Equals(
                                            TaxServiceAndApp.BI.BMain.SrvInfo?.ServiceType?.Trim(),
                                            "Omid",
                                            System.StringComparison.OrdinalIgnoreCase))
                                        {
                                            <th>Operations</th>
                                        }
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


@section js_UAGManagment {
    <script src="~/Content/MyJS/TaxOperationStatus.js" asp-append-version="true"></script>

    @if (string.Equals(
       TaxServiceAndApp.BI.BMain.SrvInfo?.ServiceType?.Trim(),
       "Omid",
       System.StringComparison.OrdinalIgnoreCase))
    {
        <script src="~/Content/MyJS/OmidSendInvoice.js" asp-append-version="true"></script>
    }
    else
    {
        <script src="~/Content/MyJS/SendInvoice.js" asp-append-version="true"></script>
    }
}
