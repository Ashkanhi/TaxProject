            </div>
            <div class="modal-body">
                <form id="MDL_EC_frm">
                    <div class="x_panel row">
                        <div class="form-group">
                            <label class="control-label col-md-12 col-sm-12 col-xs-12" for="MDL_EC_Subject">
                                عنوان <span class="required">*</span>
                            </label>

                            <div class="col-md-12 col-sm-12 col-xs-12">
                                <input id="MDL_EC_Subject" type="text" class="form-control">
