<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@(string.Equals(TaxServiceAndApp.BI.BMain.SrvInfo?.ServiceType?.Trim(), "NewTax", System.StringComparison.OrdinalIgnoreCase) ? "پرتال مودیان باران" : "جدول ها | کنترل پنل")</title>
    <!-- Tell the browser to be responsive to screen width -->
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <!-- Bootstrap 3.3.7 -->
