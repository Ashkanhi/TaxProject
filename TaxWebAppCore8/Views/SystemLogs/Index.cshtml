@model TaxWebAppCore8.Models.SystemLogsPageModel

@{
    ViewData["Title"] = "لاگ‌های سیستم";
}

<section class="content-header">
    <h1>لاگ‌های سیستم</h1>
</section>

<section class="content">
    <div class="box box-primary">
        <div class="box-body">
            <form asp-controller="SystemLogs" asp-action="Index" method="get">
                <label for="fileName">فایل لاگ</label>

                <select id="fileName" name="fileName" class="form-control">
                    <option value=""
                            selected="@(string.IsNullOrEmpty(Model.SelectedFileName))">
                        همهٔ فایل‌ها
                    </option>

                    @foreach (var file in Model.Files)
                    {
                        <option value="@file.FileName"
                                selected="@(Model.SelectedFileName == file.FileName)">
                            @file.FileName —
                            @file.LastWriteTime.ToString("yyyy/MM/dd HH:mm:ss")
                        </option>
                    }
                </select>

                <button type="submit"
                        class="btn btn-primary"
                        style="margin-top:10px">
                    نمایش / بازخوانی
                </button>
            </form>

            <p style="margin-top:15px">
                آخرین @Model.Entries.Count رخداد، از جدید به قدیم
            </p>
        </div>
    </div>

    @if (Model.Entries.Count == 0)
    {
        <div class="alert alert-info">
            لاگی برای نمایش پیدا نشد.
        </div>
    }
    else
    {
        @foreach (var entry in Model.Entries)
        {
            <div class="box box-default">
                <div class="box-header">
                    <strong class="js-log-time">
                        @entry.Timestamp.ToString("yyyy/MM/dd HH:mm:ss.fff")
                    </strong>
                    —
                    <span class="js-log-file">@entry.FileName</span>

                    <button type="button"
                            class="btn btn-default btn-sm"
                            style="float:left"
                            title="کپی کل این رخداد"
                            aria-label="کپی کل این رخداد"
                            onclick="copySystemLog(this)">
                        <i class="fa fa-copy"></i>
                    </button>
                </div>

                <div class="box-body">
                    <pre class="js-log-text"
                         style="white-space:pre-wrap; direction:ltr; text-align:left;">@entry.Text</pre>
                </div>
            </div>
        }
    }
</section>

@section js_UAGManagment {
    <script>
        async function copySystemLog(button) {
            // کادر مربوط به همان دکمه‌ای را پیدا می‌کنیم که کاربر کلیک کرده است.
            const box = button.closest(".box");

            const time = box.querySelector(".js-log-time").textContent.trim();
            const fileName = box.querySelector(".js-log-file").textContent.trim();
            const logText = box.querySelector(".js-log-text").textContent;

            // تمام اطلاعات قابل‌مشاهدهٔ رخداد را برای کپی آماده می‌کنیم.
            const textToCopy = time + " — " + fileName + "\n" + logText;

            try {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    // روش اصلی در localhost و مرورگرهای جدید.
                    await navigator.clipboard.writeText(textToCopy);
                } else {
                    // روش جایگزین برای مرورگرهایی که Clipboard API ندارند.
                    const temporaryInput = document.createElement("textarea");
                    temporaryInput.value = textToCopy;
                    temporaryInput.style.position = "fixed";
                    temporaryInput.style.opacity = "0";

                    document.body.appendChild(temporaryInput);
                    temporaryInput.select();

                    const copied = document.execCommand("copy");
                    temporaryInput.remove();

                    if (!copied) {
                        throw new Error("کپی انجام نشد.");
                    }
                }

                // علامت تیک، موفقیت کپی را برای دو ثانیه نشان می‌دهد.
                const icon = button.querySelector("i");
                icon.className = "fa fa-check";
                button.title = "کپی شد";

                setTimeout(function () {
                    icon.className = "fa fa-copy";
                    button.title = "کپی کل این رخداد";
                }, 2000);
            } catch (error) {
                alert("کپی لاگ انجام نشد. دسترسی کلیپ‌بورد مرورگر را بررسی کنید.");
            }
        }
    </script>
}